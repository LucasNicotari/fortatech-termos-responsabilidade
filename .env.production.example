# Copie para .env.production somente no servidor. Nao envie esse arquivo preenchido ao Git.
FORTADOCS_DOMAIN=termos.example.com
TRAEFIK_NETWORK=fortatech-proxy
FORTADOCS_ENV_FILE=.env.production
APP_REVISION=manual

# Supabase/PostgreSQL. Use session pooler ou conexao direta para o backend persistente.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_CHANGE_ME

# Gere valores independentes com: openssl rand -base64 48
JWT_SECRET=CHANGE_ME
BITRIX_TOKEN_ENCRYPTION_KEY=CHANGE_ME_WITH_AT_LEAST_32_CHARACTERS

# Aplicativo local do Bitrix24.
BITRIX_CLIENT_ID=local.CHANGE_ME
BITRIX_CLIENT_SECRET=CHANGE_ME
BITRIX_PORTAL_ORIGIN=https://fortaeqt.bitrix24.com.br
BITRIX_TERM_OPERATOR_USER_IDS=8243,8465
BITRIX_TERM_NOTIFICATION_USER_IDS=7718,8137
BITRIX_SIGN_COMPANY_CRM_ID=67539
BITRIX_DRIVE_OWNER_USER_ID=8465
# Opcional: evita depender da descoberta do Drive em todas as novas instancias.
BITRIX_DRIVE_STORAGE_ID=
BITRIX_DRIVE_FOLDER_NAME=Termo de Responsabilidade

# Conversao e armazenamento.
STORAGE_DRIVER=supabase
PDF_CONVERSION_CONCURRENCY=1
PDF_CONVERSION_QUEUE_LIMIT=20
PDF_CONVERSION_QUEUE_TIMEOUT_MS=30000
